[Unit]
Description=CragCast forecast server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
ExecStart={{.Bin}} serve{{range .Regions}} --region {{.}}{{end}} --regions-dir {{.RegionsDir}} --from {{.From}} --addr {{.Addr}}{{if .Github}} --github {{.Github}}{{end}}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
