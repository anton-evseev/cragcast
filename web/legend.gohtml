{{define "legend-colors" -}}
    <ul class="legend-colors" aria-label="Condition ratings">
        <li><span class="legend-dot go" aria-hidden="true"></span>Good</li>
        <li><span class="legend-dot warn" aria-hidden="true"></span>Marginal</li>
        <li><span class="legend-dot wet" aria-hidden="true"></span>Poor</li>
    </ul>
{{- end}}

