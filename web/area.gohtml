{{define "cell" -}} {{if .Split}}
<button type="button" class="cell split" data-day="{{.Day}}" data-am="{{.AMData}}" data-pm="{{.PMData}}" {{if .Label}} aria-label="{{.Label}}" {{end}}>
    <div class="band {{.AM.Class}}">
        <small>AM</small><svg><use href="#{{.AM.Icon}}" /></svg>
    </div>
    <div class="band {{.PM.Class}}">
        <small>PM</small><svg><use href="#{{.PM.Icon}}" /></svg>
    </div>
</button>
{{else}}
<button type="button" class="cell {{.Class}}" data-day="{{.Day}}" data-am="{{.AMData}}" data-pm="{{.PMData}}">
    <svg><use href="#{{.Icon}}" /></svg><span class="temp">{{.Temp}}</span
    ><span class="sr-only">{{.Label}}</span>
</button>
{{end}} {{- end -}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{.AreaName}} — climbing conditions within driving distance of {{.Region}} — Cragcast</title>
        <meta name="description" content="{{.Description}}" />
        {{template "styles"}}
        <style>
            .weather-details {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }
            .weather-details th, .weather-details td {
                padding: 4px 2px;
                text-align: center;
            }
            .weather-details th:first-child, .weather-details td:first-child {
                width: 48%;
                text-align: left;
            }
            .weather-details th { font-size: 12px; font-weight: 550; }
            .weather-details thead th { font-weight: 700; }
            .detail-note { margin: 8px 0 0; color: var(--muted); font-size: 11px; }
        </style>
    </head>
    <body>
        {{template "icons"}}

        <div class="app">
            <header>
                <div class="wordmark">
                    <a href="/{{.RegionId}}">Cragcast</a>
                </div>
                <div class="header-subline">
                    <div class="tagline">
                        {{.AreaName}} · {{.Drive}} drive from {{.Region}}
                    </div>
                    {{template "legend-colors"}}
                </div>
                <div class="updated">
                    <span class="dot"></span>Updated {{.Updated}}
                </div>
            </header>

            <main>
                <div class="days" aria-hidden="true">
                    {{- range .Days}}
                    <div class="day"><b>{{.Label}}</b><small>{{.Date}}</small></div>
                    {{- end}}
                </div>

                <section class="area">
                    <h2>
                        {{.AreaName}} <span class="drive">{{.Drive}} drive</span>
                        <a class="more" href="/{{.RegionId}}">← all areas</a>
                    </h2>
                    {{range .Crags}}
                    <div class="crag">
                        <div class="crag-head">
                            <span class="crag-name">{{.Name}}</span>
                            <span class="aspect"
                                ><svg><use href="#{{.AspectIcon}}" /></svg>
                                {{.Aspect}}</span
                            >
                        </div>
                        <div class="forecast">
                            {{- range .Cells}} {{template "cell" .}} {{- end}}
                        </div>
                        <div class="detail" hidden></div>
                    </div>
                    {{- end}}
                </section>
            </main>

            {{template "footer" .Footer}}
        </div>

        <script>
            // Tap a cell to expand its detail panel; data lives in the cell's
            // data-* attributes (see windowData in scrape.go). One panel per
            // crag, reused — only one is open at a time, page-wide.
            (function () {
                var app = document.querySelector(".app");
                var active = null; // the currently expanded cell

                app.querySelectorAll(".cell").forEach(function (c) {
                    c.setAttribute("aria-expanded", "false");
                });

                {{template "detail-metric"}}

                function values(win) {
                    var p = win.split(",");
                    var grades = (p[13] || "").split("|");
                    return [
                        metric(p[2], "°F", grades[0]),
                        metric(p[7], " in", grades[1]),
                        metric(p[8], "%", grades[2]),
                        metric(p[9], " in", grades[3]),
                        metric(p[10], "%"),
                        metric(p[11], "°F", grades[4]),
                        metric(p[4], " mph", grades[5]),
                        metric(p[5], "", grades[6])
                    ];
                }

                function details(am, pm) {
                    var morning = values(am), afternoon = values(pm);
                    var labels = ["Temperature", "Precipitation", "Precipitation chance",
                        "Past precipitation (72h)", "Humidity", "Dew point", "Wind", "Air Quality Index"];
                    return '<table class="weather-details"><thead><tr><td></td>' +
                        '<th scope="col">AM</th><th scope="col">PM</th></tr></thead><tbody>' +
                        labels.map(function (label, i) {
                            return '<tr><th scope="row">' + label + '</th><td>' +
                                morning[i] + '</td><td>' + afternoon[i] + '</td></tr>';
                        }).join("") + '</tbody></table>' +
                        '<p class="detail-note">AM 7am–1pm · PM 1pm–7pm. Past precipitation covers the 72 hours before each window.<br>Temperature, humidity, dew point, wind, and chance show window peaks.</p>';
                }

                function close(restoreFocus) {
                    if (!active) return;
                    active.setAttribute("aria-expanded", "false");
                    active.closest(".crag").querySelector(".detail").hidden = true;
                    if (restoreFocus) active.focus({ preventScroll: true });
                    active = null;
                }

                app.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && active) {
                        e.preventDefault();
                        close(true);
                    }
                });

                app.addEventListener("click", function (e) {
                    if (e.target.closest(".detail-close")) {
                        close(true);
                        return;
                    }
                    var cell = e.target.closest(".cell");
                    if (!cell) return;
                    if (cell === active) {
                        close(true);
                        return;
                    }
                    close();
                    var panel = cell.closest(".crag").querySelector(".detail");
                    panel.innerHTML =
                        '<button type="button" class="detail-close" aria-label="Close details">×</button>' +
                        '<div class="detail-day">' + cell.dataset.day + "</div>" +
                        details(cell.dataset.am, cell.dataset.pm);
                    panel.hidden = false;
                    cell.setAttribute("aria-expanded", "true");
                    active = cell;
                });
            })();
        </script>
    </body>
</html>
