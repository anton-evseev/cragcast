{{define "cell" -}} {{if .Split}}
<button type="button" class="cell split" data-day="{{.Day}}" data-am="{{.AMData}}" data-pm="{{.PMData}}" {{if .Label}} aria-label="{{.Label}}" {{end}}>
    <div class="band {{.AM.Class}}">
        <small>AM</small><svg><use href="#{{.AM.Icon}}" /></svg>
    </div>
    <div class="band {{.PM.Class}}">
        <small>PM</small><svg><use href="#{{.PM.Icon}}" /></svg>
    </div>
</button>
{{else}}
<button type="button" class="cell {{.Class}}" data-day="{{.Day}}" data-am="{{.AMData}}" data-pm="{{.PMData}}">
    <svg><use href="#{{.Icon}}" /></svg><span class="temp">{{.Temp}}</span
    ><span class="sr-only">{{.Label}}</span>
</button>
{{end}} {{- end -}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{.AreaName}} — climbing conditions within driving distance of {{.Region}} — Cragcast</title>
        <meta name="description" content="{{.Description}}" />
        {{template "styles"}}
    </head>
    <body>
        {{template "icons"}}

        <div class="app">
            <header>
                <div class="wordmark">
                    <a href="/{{.RegionId}}">Cragcast</a>
                </div>
                <div class="header-subline">
                    <div class="tagline">
                        {{.AreaName}} · {{.Drive}} drive from {{.Region}}
                    </div>
                    {{template "legend-colors"}}
                </div>
                <div class="updated">
                    <span class="dot"></span>Updated {{.Updated}}
                </div>
            </header>

            <main>
                <div class="days" aria-hidden="true">
                    {{- range .Days}}
                    <div class="day"><b>{{.Label}}</b><small>{{.Date}}</small></div>
                    {{- end}}
                </div>

                <section class="area">
                    <h2>
                        {{.AreaName}} <span class="drive">{{.Drive}} drive</span>
                        <a class="more" href="/{{.RegionId}}">← all areas</a>
                    </h2>
                    {{range .Crags}}
                    <div class="crag">
                        <div class="crag-head">
                            <span class="crag-name">{{.Name}}</span>
                            <span class="aspect"
                                ><svg><use href="#{{.AspectIcon}}" /></svg>
                                {{.Aspect}}</span
                            >
                        </div>
                        <div class="forecast">
                            {{- range .Cells}} {{template "cell" .}} {{- end}}
                        </div>
                        <div class="detail" hidden></div>
                    </div>
                    {{- end}}
                </section>
            </main>

            {{template "footer" .Footer}}
        </div>

        <script>
            // Tap a cell to expand its detail panel; data lives in the cell's
            // data-* attributes (see windowData in scrape.go). One panel per
            // crag, reused — only one is open at a time, page-wide.
            (function () {
                var app = document.querySelector(".app");
                var active = null; // the currently expanded cell

                app.querySelectorAll(".cell").forEach(function (c) {
                    c.setAttribute("aria-expanded", "false");
                });

                // win = "class,reason,temp,wetness,wind,aqi,highlights"; stats blank on
                // no data. Rendered as grid cells (label, temp, wetness,
                // wind, AQI) so AM and PM line up — the same columns the
                // region page's crag list uses (see .crag-grid).
                {{template "detail-metric"}}

                function row(label, win) {
                    var p = win.split(",");
                    var grades = (p[6] || "").split("|");
                    return (
                        '<span class="cg-name ' + p[0] + '">' + label +
                        '</span>' +
                        metric(p[2], "°", grades[0]) +
                        metric(p[3], "", grades[1], "cg-wetness") +
                        metric(p[4], " mph", grades[2]) +
                        metric(p[5], "", grades[3])
                    );
                }

                function close(restoreFocus) {
                    if (!active) return;
                    active.setAttribute("aria-expanded", "false");
                    active.closest(".crag").querySelector(".detail").hidden = true;
                    if (restoreFocus) active.focus({ preventScroll: true });
                    active = null;
                }

                app.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && active) {
                        e.preventDefault();
                        close(true);
                    }
                });

                app.addEventListener("click", function (e) {
                    if (e.target.closest(".detail-close")) {
                        close(true);
                        return;
                    }
                    var cell = e.target.closest(".cell");
                    if (!cell) return;
                    if (cell === active) {
                        close(true);
                        return;
                    }
                    close();
                    var panel = cell.closest(".crag").querySelector(".detail");
                    panel.innerHTML =
                        '<button type="button" class="detail-close" aria-label="Close details">×</button>' +
                        '<div class="detail-day">' + cell.dataset.day + "</div>" +
                        '<div class="crag-grid"><span></span>' +
                        '<span class="cg-head">temp</span>' +
                        '<span class="cg-head cg-wetness">wetness</span>' +
                        '<span class="cg-head">wind</span>' +
                        '<span class="cg-head">AQI</span>' +
                        row("AM", cell.dataset.am) +
                        row("PM", cell.dataset.pm) +
                        "</div>";
                    panel.hidden = false;
                    cell.setAttribute("aria-expanded", "true");
                    active = cell;
                });
            })();
        </script>
    </body>
</html>
