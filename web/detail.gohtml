{{define "detail-metric" -}}
function metric(value, unit, grade) {
    var present = value !== undefined && value !== "" && value !== "—";
    var highlight = present && (grade === "warn" || grade === "wet");
    return '<span class="cg-num' + (highlight ? ' ' + grade : '') + '">' +
        (present ? value + unit : "—") + '</span>';
}
{{- end}}
