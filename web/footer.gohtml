{{define "footer" -}}
<style>
    footer {
        margin-top: 24px;
        padding-top: 14px;
        border-top: 1px solid var(--hair);
        font-size: 12px;
        color: var(--muted);
        text-align: center;
    }
    footer a {
        color: inherit;
        text-decoration: underline;
    }
</style>
<footer>
    {{if .ShowAbout}}<a href="/about">About</a> · {{end}}<a href="{{if .Github}}{{.Github}}{{else}}https://github.com/anton-evseev/cragcast{{end}}">GitHub</a> · Forecast data by <a href="https://open-meteo.com/">Open-Meteo</a> and <a href="https://atmosphere.copernicus.eu/">CAMS</a>
</footer>
{{- end}}
