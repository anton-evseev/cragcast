{{define "footer" -}}
<style>
    footer {
        margin-top: 24px;
        padding-top: 14px;
        border-top: 1px solid var(--hair);
        font-size: 12px;
        color: var(--muted);
        text-align: center;
    }
    footer a {
        color: inherit;
        text-decoration: underline;
    }
</style>
<footer>
    {{if .ShowAbout}}<a href="/about">About</a> · {{end}}Forecast data by <a href="https://open-meteo.com/">Open-Meteo</a> (CC BY 4.0) · Air quality by <a href="https://atmosphere.copernicus.eu/">CAMS</a>{{if .Github}} · <a href="{{.Github}}">GitHub</a>{{end}}
</footer>
{{- end}}
