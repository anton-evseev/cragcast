{{define "styles" -}}
<style>
    :root {
        --page: #ffffff;
        --text: #14161a;
        --muted: #62686f;
        --hair: rgba(20, 22, 26, 0.1);
        --go-bg: #d7ecc9;
        --go-fg: #2c6b2e;
        --warn-bg: #f6e4bf;
        --warn-fg: #8a5a10;
        --wet-bg: #f3d2d2;
        --wet-fg: #9c2b2b;
        --cell-r: 9px;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --page: #0e1014;
            --text: #e7e9ec;
            --muted: #969ca4;
            --hair: rgba(255, 255, 255, 0.1);
            --go-bg: #1d3325;
            --go-fg: #93d79c;
            --warn-bg: #382c18;
            --warn-fg: #e0b06f;
            --wet-bg: #3a2121;
            --wet-fg: #e79898;
        }
    }

    * {
        box-sizing: border-box;
    }
    html {
        -webkit-text-size-adjust: 100%;
    }
    body {
        margin: 0;
        background: var(--page);
        color: var(--text);
        font:
            15px/1.5 system-ui,
            -apple-system,
            "Segoe UI",
            Roboto,
            sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    .app {
        max-width: 520px;
        margin: 0 auto;
        padding: 22px 16px 40px;
    }

    /* ---- header ---- */
    header {
        position: relative;
        margin-bottom: 18px;
    }
    .wordmark {
        font-size: 21px;
        font-weight: 650;
        letter-spacing: -0.02em;
    }
    .wordmark a {
        color: inherit;
        text-decoration: none;
    }
    .tagline {
        color: var(--muted);
        font-size: 13px;
        margin-top: 2px;
    }
    .header-subline {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-top: 2px;
    }
    .header-subline .tagline {
        min-width: 0;
        margin-top: 0;
    }
    .updated {
        position: absolute;
        top: 0;
        right: 0;
        color: var(--muted);
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .updated .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--go-fg);
    }

    /* ---- forecast legend ---- */
    .legend-colors {
        display: flex;
        flex-shrink: 0;
        gap: 10px;
        padding: 0;
        margin: 0;
        list-style: none;
        font-size: 11px;
        color: var(--text);
    }
    .legend-colors li {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }
    .legend-dot.go { background: var(--go-fg); }
    .legend-dot.warn { background: var(--warn-fg); }
    .legend-dot.wet { background: var(--wet-fg); }

    /* ---- sticky day header ---- */
    .days {
        position: sticky;
        top: 0;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
        background: var(--page);
        padding: 12px 0 8px;
        margin-top: 10px;
        border-bottom: 1px solid var(--hair);
    }
    .day {
        text-align: center;
    }
    .day b {
        display: block;
        font-size: 12px;
        font-weight: 600;
    }
    .day small {
        color: var(--muted);
        font-size: 10px;
    }

    /* ---- area + crag ---- */
    .area {
        padding-top: 10px;
    }
    .area h2 {
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.015em;
        margin: 26px 2px 6px;
        display: flex;
        align-items: baseline;
        gap: 8px;
    }
    .area h2 .drive {
        font-size: 12px;
        color: var(--muted);
        font-weight: 400;
    }
    .area h2 .more {
        margin-left: auto;
        font-size: 12px;
        font-weight: 500;
        color: var(--go-fg);
        text-decoration: none;
        white-space: nowrap;
    }
    .area h2 .more:hover {
        text-decoration: underline;
    }
    .crag-head {
        display: flex;
        align-items: baseline;
        gap: 7px;
        margin: 12px 2px 6px;
    }
    .crag-name {
        font-size: 14px;
        font-weight: 550;
    }
    .aspect {
        font-size: 11px;
        color: var(--muted);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .aspect svg {
        width: 12px;
        height: 12px;
    }

    /* ---- forecast cells ---- */
    .forecast {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
    }

    .cell {
        min-height: 58px;
        border-radius: var(--cell-r);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        cursor: pointer;
        /* button resets */
        width: 100%;
        padding: 0;
        border: 0;
        background: none; /* clear UA ButtonFace (showed in the split gap) */
        font: inherit;
        color: inherit;
        appearance: none;
        -webkit-appearance: none;
    }
    .cell svg {
        width: 17px;
        height: 17px;
    }
    .cell .icons {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }
    .cell .sep {
        font-size: 13px;
        opacity: 0.6;
    }
    .cell .temp {
        font-size: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .cell.go {
        background: var(--go-bg);
        color: var(--go-fg);
    }
    .cell.warn {
        background: var(--warn-bg);
        color: var(--warn-fg);
    }
    .cell.wet {
        background: var(--wet-bg);
        color: var(--wet-fg);
    }

    /* split AM/PM cell */
    .cell.split {
        padding: 0;
    }
    .band {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .band svg {
        width: 13px;
        height: 13px;
    }
    .band small {
        font-size: 10px;
        font-weight: 600;
    }
    .band.go {
        background: var(--go-bg);
        color: var(--go-fg);
    }
    .band.warn {
        background: var(--warn-bg);
        color: var(--warn-fg);
    }
    .band.wet {
        background: var(--wet-bg);
        color: var(--wet-fg);
    }

    /* ---- tap-to-expand detail panel (toggled by JS via [hidden]) ---- */
    .detail {
        position: relative;
        margin: 6px 0 2px;
        padding: 10px 30px 10px 12px;
        border: 1px solid var(--hair);
        border-radius: var(--cell-r);
        font-size: 13px;
        overflow-x: auto;
    }
    .detail-close {
        position: absolute;
        top: 4px;
        right: 8px;
        padding: 0 4px;
        border: 0;
        background: none;
        cursor: pointer;
        color: var(--muted);
        font: inherit;
        font-size: 20px;
        line-height: 1;
    }
    .detail-day {
        font-weight: 600;
        margin-bottom: 6px;
    }
    /* Shared day-detail grid: the per-crag list on the region page and the
       AM/PM detail on the crag subpage use the same columns (label,
       temp, wetness, wind, AQI) so the two read as one. */
    .crag-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 3rem 6.75rem repeat(2, 3rem);
        min-width: 404px;
        align-items: baseline;
        gap: 3px 8px;
        margin-top: 4px;
    }
    .cg-head {
        justify-self: center;
        font-size: 10px;
        font-weight: 700;
        color: var(--text);
    }
    .cg-name {
        font-weight: 550;
    }
    .cg-name {
        min-width: 0;
        overflow-wrap: anywhere;
        text-align: left;
    }
    .cg-name.go {
        color: var(--go-fg);
    }
    .cg-name.warn {
        color: var(--warn-fg);
    }
    .cg-name.wet {
        color: var(--wet-fg);
    }
    .cg-num {
        justify-self: center;
        color: var(--muted);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }


    .cg-wetness {
        text-align: center;
        overflow-wrap: anywhere;
    }

    .cg-num.warn {
        color: var(--warn-fg);
        font-weight: 650;
    }
    .cg-num.wet {
        color: var(--wet-fg);
        font-weight: 650;
    }

    @media (max-width: 639px) {
        .day b {
            font-size: 12px;
        }
        .day small {
            font-size: 10px;
            white-space: nowrap;
        }
        .cell .icons {
            gap: 1px;
        }
        .cell .icons svg:not(:only-child) {
            width: 11px;
            height: 14px;
        }
        .cell .sep {
            font-size: 10px;
        }
        .cell.split {
            min-height: 74px;
        }
        .band {
            flex-direction: column;
            gap: 0;
            padding: 2px 0;
        }
        .detail {
            padding: 10px 12px;
        }
        .crag-grid {
            min-width: 0;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            column-gap: 4px;
        }
        .crag-grid > span:first-child {
            display: none;
        }
        .cg-name {
            grid-column: 1 / -1;
            margin-top: 6px;
        }
        .cg-name.go,
        .cg-name.warn,
        .cg-name.wet {
            color: var(--text);
        }
        .cg-num {
            min-width: 0;
        }
        .cg-wetness {
            grid-column: span 2;
        }
    }

    /* Desktop gives all seven days equal space. */
    @media (min-width: 640px) {
        .crag-grid {
            column-gap: 12px;
        }
        .app {
            max-width: 660px;
        }
        .days,
        .forecast {
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
        }
    }

    :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 2px;
        border-radius: 4px;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
        .cell {
            transition: filter 0.12s ease;
        }
        .cell:hover {
            filter: brightness(0.97);
        }
        @media (prefers-color-scheme: dark) {
            .cell:hover {
                filter: brightness(1.12);
            }
        }
    }
</style>
{{- end}}

{{define "icons" -}}
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <symbol id="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
    </symbol>
    <symbol id="i-partly-cloudy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8a4 4 0 1 0-6 5M8 1v2M1 8h2M3 3l1.5 1.5M13 3l-1.5 1.5" />
        <path d="M8 21a4 4 0 1 1 .6-7.96A5 5 0 0 1 18.5 14.5 3.3 3.3 0 0 1 18 21H8z" />
    </symbol>
    <symbol id="i-drop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3.2s6 5.8 6 9.6a6 6 0 1 1-12 0c0-3.8 6-9.6 6-9.6z" />
    </symbol>
    <symbol id="i-cold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z" />
    </symbol>
    <symbol id="i-unknown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4" />
        <circle cx="12" cy="17" r="1" fill="currentColor" stroke="none" />
    </symbol>
    <symbol id="i-air" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3L2 21h20zM12 9v5" />
        <circle cx="12" cy="17.5" r="1" fill="currentColor" stroke="none" />
    </symbol>
    <symbol id="i-wind" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h11a3 3 0 1 0-3-3M2 12h17a3 3 0 1 1-3 3M4 16h6a3 3 0 1 1-3 3" />
    </symbol>
    <symbol id="i-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 15.5a4 4 0 1 1 .6-7.96A5 5 0 0 1 17.5 9a3.3 3.3 0 0 1 .2 6.5" />
        <path d="M8.5 18l-1 2.2M12 18l-1 2.2M15.5 18l-1 2.2" />
    </symbol>
    <symbol id="i-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 18a4 4 0 1 1 .6-7.96A5 5 0 0 1 17.5 11.5 3.3 3.3 0 0 1 17 18H7z" />
    </symbol>
</svg>
{{- end}}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Cragcast — climbing conditions</title>
        <link rel="canonical" href="https://cragcast.org/{{.RegionId}}" />
        <meta name="description" content="Compare climbing conditions at crags near {{.Region}} with forecasts for rain, temperature, wind, and air quality." />
        {{template "styles"}}
    </head>
    <body>
        {{template "icons"}}

        <div class="app">
            <header>
                <div class="wordmark">Cragcast</div>
                <div class="header-subline">
                    <div class="tagline">
                        Climbing conditions within driving distance of {{.Region}}
                    </div>
                    {{template "legend-colors"}}
                </div>
                <div class="updated">
                    <span class="dot"></span>Updated {{.Updated}}
                </div>
            </header>

            <main>
                <div class="days" aria-hidden="true">
                    {{- range .Days}}
                    <div class="day"><b>{{.Label}}</b><small>{{.Date}}</small></div>
                    {{- end}}
                </div>

                {{range .Areas}}
                <section class="area">
                    <h2>
                        {{.Name}} <span class="drive">{{.Drive}} drive</span>
                        <a class="more" href="/{{$.RegionId}}/{{.Id}}">details →</a>
                    </h2>
                    <div class="forecast" data-area="{{.Id}}">
                        {{- range .Cells}}
                        <button type="button" class="cell {{.Class}}" data-day="{{.Day}}">
                            <span class="icons"
                                >{{range $i, $ic := .Icons}}{{if $i}}<span class="sep">/</span>{{end}}<svg><use href="#{{$ic}}" /></svg>{{end}}</span
                            ><span class="temp">{{.Temp}}</span
                            ><span class="sr-only">{{.Label}}</span>
                        </button>
                        {{- end}}
                    </div>
                    <div class="detail" hidden></div>
                </section>
                {{end}}
            </main>

            {{template "footer" .Footer}}
        </div>

        <script>
            // Tap an area's day cell to reveal that day's crag-by-crag list.
            // CRAGS[areaId][dayIndex] =
            //   [dayLabel, [[name, class, reason, temp, wetness, wind, aqi, highlights], ...]]
            // (positional to keep the page small — see cragsData in scrape.go).
            var CRAGS = {{.CragsJSON}};
            (function () {
                var app = document.querySelector(".app");
                var active = null; // the currently expanded cell

                app.querySelectorAll(".cell").forEach(function (c) {
                    c.setAttribute("aria-expanded", "false");
                });

                // Lay the crags out as a grid so the columns line up down the
                // card — the same columns the crag subpage shows per window.
                // c = [name, class, reason, temp, wetness, wind, aqi, highlights].
                {{template "detail-metric"}}

                function crags(day) {
                    var rows = day[1]
                        .map(function (c) {
                            var grades = (c[7] || "").split("|");
                            return (
                                '<span class="cg-name ' + c[1] + '">' + c[0] +
                                '</span>' +
                                metric(c[3], "", grades[0]) +
                                metric(c[4], "", grades[1], "cg-wetness") +
                                metric(c[5], "", grades[2]) +
                                metric(c[6], "", grades[3])
                            );
                        })
                        .join("");
                    return (
                        '<div class="crag-grid"><span></span>' +
                        '<span class="cg-head">temp</span>' +
                        '<span class="cg-head cg-wetness">wetness</span>' +
                        '<span class="cg-head">wind</span>' +
                        '<span class="cg-head">AQI</span>' + rows + "</div>"
                    );
                }

                function close(restoreFocus) {
                    if (!active) return;
                    active.setAttribute("aria-expanded", "false");
                    active.closest(".area").querySelector(".detail").hidden = true;
                    if (restoreFocus) active.focus({ preventScroll: true });
                    active = null;
                }

                app.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && active) {
                        e.preventDefault();
                        close(true);
                    }
                });

                app.addEventListener("click", function (e) {
                    if (e.target.closest(".detail-close")) {
                        close(true);
                        return;
                    }
                    var cell = e.target.closest(".cell");
                    if (!cell) return;
                    if (cell === active) {
                        close(true);
                        return;
                    }
                    close();
                    var area = cell.closest(".forecast").dataset.area;
                    var day = CRAGS[area][+cell.dataset.day];
                    var panel = cell.closest(".area").querySelector(".detail");
                    panel.innerHTML =
                        '<button type="button" class="detail-close" aria-label="Close details">×</button>' +
                        '<div class="detail-day">' + day[0] + "</div>" +
                        crags(day);
                    panel.hidden = false;
                    cell.setAttribute("aria-expanded", "true");
                    active = cell;
                });
            })();
        </script>
    </body>
</html>
